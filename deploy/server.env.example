# ---------------------------------------------------------------------------
# dsh-mesh server configuration.
#
# Copy to `server.env` and fill in. This file is git-ignored.
#
# Two deployment shapes share one image:
#
#   personal — one trust domain, admin password + pairing codes, no accounts.
#              This is the original v0 behaviour and needs no mail server.
#
#   account  — multi-tenant. Email-code login, a web portal, and one account per
#              person. Requires a mail transport and an account pepper.
#
# Set DSH_MESH_MODE and fill in only the matching block.
# ---------------------------------------------------------------------------

# personal | account
DSH_MESH_MODE=personal

# ---------------------------------------------------------------------------
# The exact public origin browsers use. Includes scheme and port; a path is not
# allowed. Used for the SPA, cookies and Origin checks.
# ---------------------------------------------------------------------------
DSH_SERVER_PUBLIC_URL=https://mesh.example.com

DSH_SERVER_HOST=127.0.0.1
DSH_SERVER_PORT=8080
DSH_SERVER_DATA_FILE=/data/state.json

# ---------------------------------------------------------------------------
# PERSONAL MODE ONLY
#
# A single administrator identity; the password must be at least 12 characters.
# Ignored in account mode, where a deterministic internal scope is used and no
# shared credential exists.
# ---------------------------------------------------------------------------
DSH_SERVER_ACCOUNT=admin@example.com
DSH_SERVER_PASSWORD=

# ---------------------------------------------------------------------------
# ACCOUNT MODE — required
# ---------------------------------------------------------------------------

# HMAC key for verification-code digests, session lookups and rate-limit
# buckets. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating this value invalidates every live code and web session. Paired
# devices keep working: their tokens are hashed in the state file, not here.
DSH_MESH_ACCOUNT_PEPPER=

# SQLite database for accounts, challenges, sessions and device links.
DSH_MESH_ACCOUNT_DB=/data/accounts.sqlite3

# Optional shared invite code. Empty means anyone can register.
DSH_MESH_INVITE_CODE=

# Optional comma-separated allow list reserved for operator endpoints.
DSH_MESH_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# ACCOUNT MODE — mail
#
# console -> print codes in the server log. Fine for a private trial; never on a
#            public deployment.
# smtp    -> any SMTP server (Alibaba Cloud DirectMail, SES, Resend, Mailgun…).
# ---------------------------------------------------------------------------
DSH_MESH_MAIL_TRANSPORT=console
DSH_MESH_MAIL_APP_NAME=DSH Orb
# Defaults to DSH_MESH_SMTP_USERNAME when empty.
DSH_MESH_MAIL_FROM=
DSH_MESH_MAIL_FROM_ALIAS=

# Region shortcut for the SMTP host. Leave SMTP_HOST empty to use one of these,
# or set SMTP_HOST explicitly for any other provider.
# cn-hangzhou | ap-southeast-1 | us-east-1 | eu-central-1
DSH_MESH_MAIL_REGION=
DSH_MESH_SMTP_HOST=
# 465 = implicit TLS. 25/80 = STARTTLS. Alibaba Cloud DirectMail has no 587.
DSH_MESH_SMTP_PORT=465
# ssl | starttls | none
DSH_MESH_SMTP_SECURITY=ssl
DSH_MESH_SMTP_USERNAME=
DSH_MESH_SMTP_PASSWORD=
DSH_MESH_SMTP_TIMEOUT_SECONDS=20

# Extra throwaway domains to refuse, comma separated.
DSH_MESH_DISPOSABLE_EMAIL_DOMAINS=

# ---------------------------------------------------------------------------
# ACCOUNT MODE — limits (defaults shown; usually leave as is)
# ---------------------------------------------------------------------------
DSH_MESH_CODE_TTL_SECONDS=600
DSH_MESH_SESSION_TTL_SECONDS=604800
DSH_MESH_SEND_COOLDOWN_SECONDS=60
DSH_MESH_EMAIL_SENDS_PER_DAY=5
DSH_MESH_IP_SENDS_PER_HOUR=10
DSH_MESH_IP_SENDS_PER_DAY=30
DSH_MESH_MAX_VERIFY_FAILURES=5
# How long a device has to finish approving in the browser.
DSH_MESH_LINK_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# TLS pinning
#
# Account / hosted mode: leave empty. The client uses the platform CA store,
# which is correct for a publicly trusted certificate and survives renewals.
#
# Self-hosted with a self-signed certificate: set the SPKI SHA-256 (base64url).
# Devices then pin the public key and ignore the CA chain.
# ---------------------------------------------------------------------------
DSH_SERVER_CERT_FINGERPRINT=

# Comma-separated IPs of reverse proxies allowed to set X-Forwarded-For.
# Leave empty when clients reach this server directly.
DSH_SERVER_TRUSTED_PROXY_IPS=

# debug | info | warn | error
DSH_SERVER_LOG_LEVEL=info
