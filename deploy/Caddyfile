:443 {
	tls /certs/cert.pem /certs/key.pem

	# Public surface: device control plane only. The admin page and the legacy
	# account endpoints stay on 127.0.0.1:8080 and are reached through an SSH
	# tunnel; v0 has no browser-facing account portal.
	@device_api path /api/v1/devices/* /api/v1/devices /api/v1/auth/refresh /api/v1/nodes/* /api/v1/me /api/v1/turn/* /ws/* /health /healthz
	handle @device_api {
		reverse_proxy server:8080
	}

	respond 404
}