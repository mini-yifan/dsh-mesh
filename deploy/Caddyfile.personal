# Personal-mode reverse proxy (v0).
#
# The public surface is the device control plane only. The admin page and the
# account endpoints stay on 127.0.0.1:8080 behind an SSH tunnel.
#
# This variant serves a self-signed certificate from ./certs and therefore goes
# with DSH_SERVER_CERT_FINGERPRINT: devices pin the public key.
#
# For a publicly trusted certificate instead, replace the `tls` line with your
# domain name and let Caddy manage ACME:
#     mesh.example.com {
#         ...
#     }

:443 {
	tls /certs/cert.pem /certs/key.pem

	@device_api path /api/v1/devices/* /api/v1/devices /api/v1/auth/refresh /api/v1/nodes/* /api/v1/me /api/v1/turn/* /ws/* /health /healthz
	handle @device_api {
		reverse_proxy server:8080
	}

	respond 404
}
